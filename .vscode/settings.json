{
    "explorer.compactFolders": false,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "java.configuration.updateBuildConfiguration": "automatic",
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "java.compile.nullAnalysis.mode": "automatic"
}