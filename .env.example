# ==============================================================================
# SPEDO Social Media Analytics & Competitive Intelligence — Environment Config
# ==============================================================================

# Server Network Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Production Database (Defaults to local embedded persistent H2)
# For MySQL / MariaDB in production:
# SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/spedo_db?useSSL=true&serverTimezone=UTC
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_USERNAME=spedo_user
# SPRING_DATASOURCE_PASSWORD=YourSecureDatabasePassword!
#
# For PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/spedo_db
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=YourSecureDatabasePassword!
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/spedo_db;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
H2_CONSOLE_ENABLED=false

# Security & JSON Web Tokens (Use a 256-bit cryptographically secure hex secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Cross-Origin Resource Sharing (Comma-delimited domains or *)
CORS_ALLOWED_ORIGINS=*

# Demo Seeding Flag (Set to false for real production deployments)
DEMO_MODE_ENABLED=false

# YouTube Data API v3 Key (Used for live channel metrics & giveaway participant fetching)
APP_INTEGRATIONS_YOUTUBE_API_KEY=AIzaSyBJ-gm6tyRPjzannSWxVJt6ZF5Y84r_PHo

# Initial System Administrator Credentials
DEFAULT_ADMIN_EMAIL=arunvemula13@gmail.com
DEFAULT_ADMIN_PASSWORD=7207562840
DEFAULT_ADMIN_NAME=Arun Vemula

# Outbound SMTP Mail Dispatch (For competitor briefing emails & password reset)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
